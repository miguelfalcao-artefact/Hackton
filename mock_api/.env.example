# Copy to .env before `docker compose up`. Every value here has a working
# default in docker-compose.yml; this file exists so you can see them all.

# ------------------------------------------------------------------- database
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shop
POSTGRES_PORT=5434

# ------------------------------------------------------------------------ api
API_PORT=8100
LOG_LEVEL=INFO

# Seeding runs only when the database is empty.
SEED_ON_START=true
# Destructive: drops and recreates every table on boot. Opt in deliberately.
RESET_ON_START=false

# ------------------------------------------------------------ business rules
# Orders above this total are declined at payment. Combined with the
# "tok_decline" token prefix, this is the only way a payment fails.
PAYMENT_DECLINE_ABOVE_CENTS=500000

# --------------------------------------------------------------- rate limits
RATE_LIMIT_FREE_PER_MIN=60
RATE_LIMIT_PRO_PER_MIN=600
RATE_LIMIT_ENTERPRISE_PER_MIN=6000

# ------------------------------------------------------------------ api keys
# Format: id:key:tier,id:key:tier   (tier = free | pro | enterprise)
API_KEYS=acme-retail:acme-retail-key:enterprise,bolt-shop:bolt-shop-key:pro,quickcart:quickcart-key:free,nightowl-bot:nightowl-bot-key:free
