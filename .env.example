# Copy this file to .env and replace these paths with the production API's
# mounted/exported JSONL logs and source checkout.
# Separate multiple log paths with ':' on Linux/macOS (';' on Windows).
API_LOG_PATHS=/var/log/my-api/api.jsonl
API_SOURCE_ROOT=/srv/my-api

# Generated monitoring artifacts.
MONITOR_CSV_PATH=runtime/logs.csv
DASHBOARD_HTML_PATH=reports/api/dashboard.html

# Polling and local dashboard server.
COLLECTOR_INTERVAL_SECONDS=30
DASHBOARD_INTERVAL_SECONDS=2
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
